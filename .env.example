# 应用基础配置
APP_NAME=Go Agent System
APP_VERSION=0.1.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9205
API_V1_PREFIX=/api/v1

# HTTP 主体模式：以下仅用于受控本地开发。真实部署必须接入可信认证主体。
REQUEST_PRINCIPAL_MODE=static
STATIC_PRINCIPAL_SUBJECT=local-developer
STATIC_PRINCIPAL_PERMISSIONS=agent:tender:execute

POLICY_PIPELINE_WORKSPACE=.runtime/policy_pipeline

# 上传暂存大小上限和保留时间，分别按字节和秒配置。
POLICY_UPLOAD_MAX_SIZE_BYTES=52428800
POLICY_UPLOAD_RETENTION_SECONDS=86400

# 数据库配置
# 如果设置了 DATABASE_URL，会优先使用它，并覆盖下面的 POSTGRES_* 分项配置。
DATABASE_URL=
POSTGRES_DRIVER=postgresql+psycopg
POSTGRES_DB=go_agent_system
POSTGRES_USER=admin
POSTGRES_PASSWORD=123456
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT_SECONDS=5

#embedding模型相关配置
GITEE_API_KEY=
GITEE_BASE_URL=https://ai.gitee.com/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
VECTOR_DIMENSIONS=1024

#LLM接入
LLM_PROVIDER=glm
ZHIPU_API_KEY=
# GLM 当前默认使用有有效期的资源包；资源包耗尽或到期后手动改为 coding_plan。
GLM_RUNTIME_PROFILE=resource
ZHIPU_RESOURCE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_RESOURCE_CHAT_MODEL=glm-4.5-air
ZHIPU_RESOURCE_TIMEOUT_SECONDS=60
ZHIPU_RESOURCE_TEMPERATURE=0
ZHIPU_RESOURCE_MAX_TOKENS=16384
ZHIPU_RESOURCE_THINKING=disabled
# 资源包默认采用保守限制；请按实际套餐额度调整。每个真实 Provider 尝试均计入此配额。
ZHIPU_RESOURCE_REQUESTS_PER_MINUTE=30
ZHIPU_RESOURCE_REQUEST_BURST=3
ZHIPU_RESOURCE_REQUEST_MAX_CONCURRENCY=3
# Coding Plan 保留独立配置，日常只做受控验证，不承载当前主流量。
ZHIPU_CODING_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZHIPU_CODING_CHAT_MODEL=glm-5.3
ZHIPU_CODING_TIMEOUT_SECONDS=60
ZHIPU_CODING_TEMPERATURE=0
ZHIPU_CODING_MAX_TOKENS=16384
ZHIPU_CODING_THINKING=low
ZHIPU_CODING_REQUESTS_PER_MINUTE=10
ZHIPU_CODING_REQUEST_BURST=1
ZHIPU_CODING_REQUEST_MAX_CONCURRENCY=1
# 旧 ZHIPU_BASE_URL / ZHIPU_CHAT_MODEL / ZHIPU_*_TIMEOUT 配置只作为资源包迁移回退。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=16384
DEEPSEEK_THINKING=disabled
# 非 GLM Provider 的共享请求治理配置。`LLM_STREAM_MAX_CONCURRENCY` 已移除。
LLM_REQUESTS_PER_MINUTE=60
LLM_REQUEST_BURST=6
LLM_REQUEST_MAX_CONCURRENCY=4
# 首段等待以首个上游活动（正文或内部 reasoning）为准；reasoning 不会发送给浏览器。
LLM_STREAM_FIRST_TOKEN_TIMEOUT_SECONDS=30
LLM_STREAM_IDLE_TIMEOUT_SECONDS=20
LLM_STREAM_TOTAL_TIMEOUT_SECONDS=120
LLM_STREAM_HEARTBEAT_SECONDS=10
# SDK Client 固定零重试；以下参数只控制服务端唯一的应用级瞬态失败重试。
LLM_RETRY_MAX_ATTEMPTS=2
LLM_RETRY_BASE_BACKOFF_SECONDS=1
LLM_RETRY_MAX_BACKOFF_SECONDS=8
LLM_RETRY_MAX_RETRY_AFTER_SECONDS=30
LLM_RETRY_TOTAL_BACKOFF_BUDGET_SECONDS=30

# 前端 LLM 请求超时时间（毫秒）；普通接口仍使用 VITE_API_TIMEOUT_MS。
VITE_LLM_TIMEOUT_MS=90000
VITE_API_TIMEOUT_MS=600000

# Tender Agent：超过该文件大小后使用分块分析和全局归并（字节）
TENDER_CHUNK_THRESHOLD_BYTES=4194304

#OCR设定
OCR_PROVIDER=tencent
OCR_MODEL=glm-4.6v-flash
OCR_MAX_PAGES_PER_BATCH=4
OCR_IMAGE_MAX_SIDE=1800
OCR_TIMEOUT_SECONDS=60
OCR_REQUEST_INTERVAL_SECONDS=10
OCR_ENABLED=true

# 腾讯 OCR
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_ENDPOINT=ocr.tencentcloudapi.com
TENCENT_OCR_ACTION=GeneralAccurateOCR
# OCR 输出只允许写入运行时目录，禁止写入 tests，避免敏感识别结果进入仓库。
TENCENT_OCR_OUTPUT_ROOT=.runtime/ocr_output
TENCENT_OCR_DOCX_IMAGE_LIMIT=50
TENCENT_OCR_PDF_PAGE_LIMIT=0

#RAG召回
RETRIEVAL_TOP_K_DEFAULT=5
RETRIEVAL_TOP_K_MAX=20
VECTOR_SEARCH_STRATEGY=exact
VECTOR_SEARCH_HNSW_M=16
VECTOR_SEARCH_HNSW_EF_CONSTRUCTION=64
VECTOR_SEARCH_HNSW_EF_SEARCH=40
RAG_ANSWER_TOP_K=6
RAG_MAX_CONTEXT_CHARS_PER_CHUNK=500
